{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CourseMaster",
  "version": "0.1.0",
  "identifier": "com.beep242.coursemaster",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CourseMaster",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
