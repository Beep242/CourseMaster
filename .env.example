# Copy to .env on the VPS (never commit the real file).

GHCR_OWNER=beep242

# Must be byte-for-byte identical to PortFolio's CROSS_APP_JWT_SECRET —
# copy it from PortFolio's own .env, the same way TruthSeeker/StockMan/BPass do.
CROSS_APP_JWT_SECRET=
CROSS_APP_JWT_ISSUER=iambeep.com
CROSS_APP_JWT_AUDIENCE=coursemaster

# Your PortFolio account email — CourseMaster is single-user and rejects
# any other authenticated PortFolio account.
OWNER_EMAIL=

WEB_ALLOWED_ORIGINS=https://coursemaster.iambeep.com

# Optional: pin a specific model alias (sonnet, opus, haiku, fable) or full
# model name. Leave blank to use the claude CLI's own default.
CLAUDE_MODEL=
