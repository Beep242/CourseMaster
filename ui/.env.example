# PortFolio deployment CourseMaster signs in through (the bridge login).
VITE_PORTFOLIO_URL=https://iambeep.com

# Base URL of the CourseMaster API — must be absolute (not relative) since
# this same built bundle is loaded both from the hosted origin and from
# inside the Tauri desktop shell, which has no origin of its own to be
# relative to.
VITE_API_BASE_URL=https://coursemaster.iambeep.com/api
